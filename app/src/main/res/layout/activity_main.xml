<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F3EE">

    <com.jerrynifemi.pourlab.FluidView
        android:id="@+id/fluid"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_chip"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:paddingLeft="18dp"
        android:paddingTop="10dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:text="@string/hint"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipWater"
            style="@style/Chip"
            android:text="@string/mat_water" />

        <TextView
            android:id="@+id/chipSand"
            style="@style/Chip"
            android:text="@string/mat_sand" />

        <TextView
            android:id="@+id/chipBubbles"
            style="@style/Chip"
            android:text="@string/mat_bubbles" />

        <TextView
            android:id="@+id/chipHoney"
            style="@style/Chip"
            android:text="@string/mat_honey" />
    </LinearLayout>

    <TextView
        android:id="@+id/fabAdd"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|right"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="26sp" />
</FrameLayout>
